<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>commander_operator</name>
  <version>0.1.0</version>
  <description>An interface between human operator and the (crl_)commander package.</description>
  <maintainer email="herolada@fel.cvut.cz">Adam Herold</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <depend>commander_operator_interfaces</depend>
  <depend>crl_commander_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>python3-pyproj</depend>
  <depend>python3-yaml</depend>
  <depend>rclpy</depend>
  <!-- <depend>std_msgs</depend>
  <depend>tf2_ros</depend> -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
