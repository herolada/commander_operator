<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>commander_operator_rviz</name>
  <version>0.1.0</version>
  <description>RViz panel and tool for recording commander_operator waypoints and routes.</description>
  <maintainer email="herolada@fel.cvut.cz">Adam Herold</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>commander_operator_interfaces</depend>
  <depend>crl_commander_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>qtbase5-dev</depend>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>commander_operator</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
